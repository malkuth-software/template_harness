{
 "about": [
  "Test areas and the paths that select them (owner plan of 2026-10-22: cut redundant verification).",
  "cmake/TestAreas.cmake gives every ctest test the label area_<area> of the first entry of test_areas whose",
  "pattern its name matches; tools/change_selection.py maps the paths a branch changes to the areas whose",
  "tests it runs. Patterns use only the regular-expression subset CMake and Python share: literals, ^, $,",
  "|, (), [] and *+?.",
  "path_rules: the longest matching entry wins. An entry ending in / names a directory, an entry with * is",
  "a glob whose * stays within one path segment, any other entry names one file (or a file-name prefix",
  "under tests/). '*' in areas means every test; an empty list means no test reads the path. A path no",
  "entry matches selects every test, so a new top-level directory is safe until it is classified.",
  "A file directly under tests/ (or a subdirectory of it) whose stem names a test (X, gui_forms_X or",
  "gui_drawing_X) selects that test before path_rules apply. Independently, a test whose command line or",
  "environment names a source path selects itself when a changed path lies under it."
 ],
 "test_areas": [
  {"area": "a11y", "pattern": "accessibility"},
  {"area": "gui", "pattern": "^gui_forms_gallery_|_lab_tests$|demoboard|visual_inspect|^cursor_interaction$"},
  {"area": "host", "pattern": "^gui_forms_(windows|macos|linux|x11)_|^gui_forms_(coregraphics_smoke|runtime_windows_tests|cursor_images|window_teardown_tests|floating_windows_tests|host_image_tests|host_protocol_tests|host_boundary_audit|application_native_tests|notify_icon_tests)$"},
  {"area": "codec", "pattern": "^stx_(zlib|png|conv)_|^gui_forms_(png_|resource_pixels|inflate|deflate|freetype_zlib|malformed_sweep|interpolation)"},
  {"area": "audio", "pattern": "audio|vorbis|ogg"},
  {"area": "render", "pattern": "raster|skia|^gui_drawing_|canvas|glyph|font_metrics|text_mask|prepared_|text_shaping|harfbuzz|bounded_|grapheme|linebreak|damage|paint_group|material|part_composite|overlay_shadow|live_surface|display_chunk|text_identity|application_text|retained_draw_cache"},
  {"area": "docs", "pattern": "doc_examples|api_reference"},
  {"area": "core", "pattern": "^gui_forms_(core|abi_|anatomy|animation|background_worker|binary_search|binding_tests|c_api|command_|delegate_event|dispatcher|dock_layout|docking_vocabulary|event_payload|focus_|frame_scheduler|guidance_provider|headless_trace|invalidation|key_commands|motion_clock|owned_event|page_set|program_options|retained_lifetime|ribbon_vocabulary|semantic|shared_resources|sort_algorithm|text_store|theme|threading|timer|validation|workspace_transaction|xml|engine_|application_contract|part_painting|control_snapshot|object_details)"},
  {"area": "controls", "pattern": "."}
 ],
 "path_rules": [
  {"paths": ["docs/", "packaging/", "benchmarks/",
             "sdrsharp_reflection_system/", "*.md", "LICENSE", ".gitignore", ".gitattributes"],
   "areas": []},
  {"paths": ["CMakeLists.txt", "cmake/", "third_party/", ".github/", "assets/", "include/gui_forms/",
             "tools/ci_build.py", "tools/change_selection.py", "tools/test_areas.json", "tools/sanitizer/",
             "tests/support/", "tests/fixtures/"],
   "areas": ["*"]},
  {"paths": ["docs/library/", "generated/", "examples/", "tools/"], "areas": ["docs"]},
  {"paths": ["tools/font_metrics_differential/"], "areas": ["render"]},
  {"paths": ["src/core/", "src/abi/", "src/runtime/"], "areas": ["core", "codec", "audio", "render", "controls", "host", "docs"]},
  {"paths": ["src/core/semantics/"], "areas": ["core", "codec", "audio", "render", "controls", "host", "docs", "a11y"]},
  {"paths": ["src/core/image/"], "areas": ["codec", "render", "host"]},
  {"paths": ["stx_zlib/", "stx_png/", "stx_conv/", "src/core/interpolation/", "tests/interpolation/", "include/gui_forms/compression/", "fuzz/", "assets/fixtures/compression/", "tests/compression/", "tests/image/"],
   "areas": ["codec"]},
  {"paths": ["stx_vorbis/", "src/audio/", "include/gui_forms/audio/", "tests/audio/"], "areas": ["audio"]},
  {"paths": ["src/render/", "tests/fonts/", "tests/application_text_consumer/", "tests/drawing_", "tests/prepared_",
             "tests/text_", "tests/part_composite_", "tests/unicode_"],
   "areas": ["render", "controls", "gui", "a11y"]},
  {"paths": ["src/controls/", "include/gui_forms/controls/", "include/gui_forms/*_controls.hpp", "manifests/"],
   "areas": ["controls", "gui", "a11y", "docs"]},
  {"paths": ["demo/correspondence/"], "areas": ["controls", "gui", "a11y"]},
  {"paths": ["demo/program_options.hpp"], "areas": ["core", "gui", "a11y"]},
  {"paths": ["src/controls/gallery/", "demo/", "file_manager_demoboard/", "tests/gallery_pages/"], "areas": ["gui", "a11y"]},
  {"paths": ["src/host/", "tests/windows_", "tests/x11_", "tests/macos_", "tests/cursor_"], "areas": ["host", "gui", "a11y"]},
  {"paths": ["src/host/headless/"], "areas": ["core", "controls", "host", "gui", "a11y"]},
  {"paths": ["tests/linux_accessibility_", "tests/macos_accessibility_"], "areas": ["a11y"]}
 ]
}
