{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "fransushi": {
      "source": {
        "source": "github",
        "repo": "{{harness_repository}}",
        "ref": "{{harness_ref}}",
        "path": "claude/.claude-plugin/marketplace.json"
      }
    }
  },
  "enabledPlugins": {
    "sushibuild@fransushi": true,
    "sushicomms@fransushi": true,
    "sushidelivery@fransushi": false,
    "sushirice@fransushi": true,
    "sushistyle@fransushi": true,
    "sushiwrap@fransushi": true,
    "wasabi@fransushi": true
  }
}
